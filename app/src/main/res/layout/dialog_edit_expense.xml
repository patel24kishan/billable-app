<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView style="@style/FieldLabel" android:text="Date" />
    <TextView
        android:id="@+id/tv_dialog_date"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary" />

    <TextView style="@style/FieldLabel" android:layout_marginTop="12dp" android:text="Amount" />
    <EditText
        android:id="@+id/et_dialog_amount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp" />

    <TextView style="@style/FieldLabel" android:layout_marginTop="12dp" android:text="Title" />
    <EditText
        android:id="@+id/et_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:inputType="text"
        android:paddingHorizontal="12dp" />

    <TextView style="@style/FieldLabel" android:layout_marginTop="12dp" android:text="Receipt (optional, JPEG or PNG)" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/btn_dialog_attach_receipt" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp"
            android:text="Attach" android:textAllCaps="false" android:textSize="12.5sp" />
        <TextView android:id="@+id/tv_dialog_receipt_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:ellipsize="middle" android:maxLines="1"
            android:text="No receipt attached" android:textColor="@color/text_faint" android:textSize="12.5sp" />
        <ImageButton android:id="@+id/btn_dialog_remove_receipt" android:layout_width="32dp" android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Remove receipt"
            android:padding="6dp" android:src="@drawable/ic_delete" android:visibility="gone" app:tint="@color/text_faint" />
    </LinearLayout>
</LinearLayout>
