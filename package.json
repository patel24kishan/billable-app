{
  "name": "billable",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Freelance time-tracking and invoicing web app — local-first, no server, no account.",
  "main": "electron/main.js",
  "author": {
    "name": "Billable"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "vite build && electron .",
    "electron:start": "electron .",
    "smoke": "vite build && node scripts/smoke.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.billable.desktop",
    "productName": "Billable",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Billable",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Billable-Setup-${version}.exe"
    }
  }
}
